{
  "manifest_version": 3,
  "name": "Where U Elevate Exam",
  "version": "0.3.1",
  "description": "Take a proctored Where U Elevate exam in Chrome. Shares your screen and reports tabs, searches and AI chats to your proctor.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open the exam",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "__API__/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://poe.com/*",
        "https://chat.deepseek.com/*",
        "https://you.com/*",
        "https://phind.com/*",
        "https://www.phind.com/*",
        "https://character.ai/*",
        "https://huggingface.co/*",
        "https://chat.mistral.ai/*",
        "https://grok.com/*",
        "https://www.meta.ai/*",
        "https://pi.ai/*",
        "https://www.wolframalpha.com/*",
        "https://www.chegg.com/*",
        "https://www.symbolab.com/*",
        "https://www.mathway.com/*",
        "https://brainly.com/*",
        "https://brainly.in/*",
        "https://chat.qwen.ai/*",
        "https://www.blackbox.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
